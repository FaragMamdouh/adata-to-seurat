import os
import scipy.io
import scipy.sparse
import pandas as pd
import anndata as ad

os.chdir("/Volumes/BCP-ALL/Normal Dataset/thymus/integratedALL")

# --- counts (genes x cells) ---
X_counts = scipy.io.mmread("RNA_counts.mtx").tocsr()
X_data   = scipy.io.mmread("RNA_data.mtx").tocsr()

# --- metadata ---
obs = pd.read_csv("cell_metadata.csv", index_col=0)
cells = pd.read_csv("cells.csv").iloc[:, 0].astype(str)
genes = pd.read_csv("genes.csv", header=None).iloc[:, 0].astype(str)

obs.index = obs.index.astype(str)
obs = obs.loc[cells]

# --- build AnnData: counts as X, data (lognorm) as a layer ---
adata = ad.AnnData(
    X=X_counts.T,
    obs=obs,
    var=pd.DataFrame(index=genes),
)
adata.layers["counts"] = X_counts.T
adata.layers["data"]   = X_data.T

# --- scale.data (subset of genes) as a separate layer, aligned by gene name ---
if os.path.exists("RNA_scaledata.mtx"):
    X_scale = scipy.io.mmread("RNA_scaledata.mtx").tocsr()
    genes_scale = pd.read_csv("genes_scaledata.csv", header=None).iloc[:, 0].astype(str)
    scale_df = pd.DataFrame.sparse.from_spmatrix(
        X_scale.T, index=cells.values, columns=genes_scale
    )
    # reindex to full gene set, filling missing genes with NaN
    adata.layers["scale_data"] = scale_df.reindex(columns=adata.var_names).values

# --- dimensional reductions ---
pca = pd.read_csv("pca_embeddings.csv", index_col=0).loc[cells]
umap = pd.read_csv("umap_embeddings.csv", index_col=0).loc[cells]
adata.obsm["X_pca"] = pca.values
adata.obsm["X_umap"] = umap.values

# --- SCT / integrated as separate AnnData objects (different var sets) ---
def load_assay(mtx_path, genes_path, cells):
    X = scipy.io.mmread(mtx_path).tocsr()
    g = pd.read_csv(genes_path, header=None).iloc[:, 0].astype(str)
    a = ad.AnnData(X=X.T, var=pd.DataFrame(index=g))
    a.obs_names = cells.values
    return a

adata_sct = load_assay("SCT_data.mtx", "genes_SCT.csv", cells)
adata_integrated = load_assay("integrated_data.mtx", "genes_integrated.csv", cells)

# stash them if useful downstream
adata.uns["sct_var_names"] = list(adata_sct.var_names)
adata.uns["integrated_var_names"] = list(adata_integrated.var_names)
